# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Root env (Vite); never commit API keys or Supabase URLs
.env
.env.local

# Netlify serverless secrets
netlify/functions/.env

# Local script secrets
scripts/.env
scripts/service_account.json
scripts/__pycache__/
**/__pycache__/
*.py[cod]

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local metadata
.claude/

# Local Netlify folder
.netlify

# Dedup log for the one-time Telegram invite email script. Contains
# the personal email addresses of recipients who've been emailed —
# must never be committed. (Already matched by *.log above but
# called out explicitly so a maintainer doesn't accidentally
# re-broaden the *.log rule and lose this protection.)
scripts/.sent_telegram_invite_emails.log
logs/*.log

# (Removed: scripts/.validation_state.json held the publish gate's drift
# baseline. Being per-machine was the bug — it cannot exist on a fresh CI
# runner, so check 5 compared nothing there for its whole life. The
# baseline now lives in the validation_baseline table, one source of truth
# for local and CI. See scripts/sql/create_validation_baseline.sql.)

# Staging output for the static QuickScanner build. The published copy
# lives at public/quickscanner.html (committed); this is the scratch
# directory the generator and the validation gate write to.
static_build/
static_build_prev/
